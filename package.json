{
  "name": "sized",
  "version": "1.1.0",
  "description": "Create current iPhone and iPad App Store screenshots entirely in the browser",
  "type": "module",
  "license": "MIT",
  "author": "Yiftach Cohen",
  "repository": {
    "type": "git",
    "url": "https://github.com/YiftachCohen/sized.git"
  },
  "homepage": "https://ycstudios.dev/sized",
  "bugs": {
    "url": "https://github.com/YiftachCohen/sized/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.9.0",
  "keywords": [
    "ios",
    "screenshot",
    "app-store",
    "image-resize",
    "canvas"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.0",
    "ultracite": "7.9.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
